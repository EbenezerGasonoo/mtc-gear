<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive configuration, dependency, and environment files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|routes|storage/logs|tests)/.*$ - [F,L,NC]

    # If already requesting files inside public, allow them through
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Redirect all incoming traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
