APP_NAME="MTC Gear"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gear.mtc.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --------------------------------------------------------------------------
# Database Configuration (MySQL 8.0 Recommended for Production / cPanel)
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mtc_gear_db
DB_USERNAME=mtc_gear_user
DB_PASSWORD="YourSecurePasswordHere"

# Alternative: Local SQLite configuration (uncomment to use)
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database/database.sqlite

# --------------------------------------------------------------------------
# Session, Cache & Queue Settings
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# --------------------------------------------------------------------------
# File Storage
# --------------------------------------------------------------------------
FILESYSTEM_DISK=public

# --------------------------------------------------------------------------
# Mail Configuration (SMTP for Email Alerts & Overdue Notices)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD="YourSmtpPassword"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="gear-alerts@mountaintop.local"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Frontend Environment Variables
# --------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
